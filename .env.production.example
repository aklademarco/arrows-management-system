NODE_ENV=production

# Public hostname only, without https:// or a trailing slash.
APP_DOMAIN=church.example.com
WEB_URL=https://church.example.com
CORS_ORIGIN=https://church.example.com

POSTGRES_DB=arrows_cms
POSTGRES_USER=arrows
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

API_PORT=4000
API_URL=http://api:4000/api/v1
DEFAULT_CHURCH_ID=00000000-0000-4000-8000-000000000001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900

RESEND_API_KEY=re_replace_me
EMAIL_FROM=Arrows <no-reply@your-verified-domain.example>

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

SMS_ENABLED=false
MOOLRE_SMS_VAS_KEY=
MOOLRE_SENDER_ID=ARROWS
MOOLRE_DELIVERED_STATUS=2
MOOLRE_BASE_URL=

# Pin a published image tag such as v0.1.0 in production.
IMAGE_TAG=latest
